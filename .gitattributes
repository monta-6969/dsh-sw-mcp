# 仓库统一用 LF；只有 .cs 与 .ps1 按 Windows 工具链保留 CRLF。
# .ps1 是 Windows PowerShell 5.1 直接读的文件，编码/行尾一改就可能解析失败。
* text=auto eol=lf

*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf
*.cs    text eol=crlf

*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
*.SLDPRT binary
*.SLDASM binary
*.STEP  binary
*.stl   binary
