      {
        "name": "板长 225",
        "measure": "distance",
        "args": {
          "a": {
            "plane": "minX"
          },
          "b": {
            "plane": "maxX"
          }
        },
        "expect": 225,
        "tol": 0.05
      },
      {
        "name": "板宽 110",
        "measure": "distance",
        "args": {
          "a": {
            "plane": "minZ"
          },
          "b": {
            "plane": "maxZ"
          }
        },
        "expect": 110,
        "tol": 0.05
      },
      {
        "name": "总高 100（底面到拱顶 R40）",
        "measure": "distance",
        "args": {
          "a": {
            "plane": "minY"
          },
          "b": {
            "plane": "maxY"
          }
        },
        "expect": 100,
        "tol": 0.05
