{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-mcp.local/contracts/ref.schema.json",
  "title": "sw-mcp ref",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "project",
        "run",
        "instance",
        "document",
        "configuration",
        "revision",
        "job",
        "artifact"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "additionalProperties": false
}
