    "url": "git+https://github.com/monta-6969/dsh-sw-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/monta-6969/dsh-sw-mcp/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "solidworks",
    "cad",
    "mcp",
    "csharp-bridge",
    "com"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./restrict-tools.js": "./restrict-tools.js",
    "./bili-bypass.js": "./bili-bypass.js",
    "./experience-nudge.js": "./experience-nudge.js",
    "./server/server.mjs": "./server/server.mjs",
    "./package.json": "./package.json",
    "./experience-digest.js": "./experience-digest.js",
    "./review-gate.js": "./review-gate.js",
    "./prompt-surface.js": "./prompt-surface.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File bridge/build.ps1",
    "test": "node test/suite.mjs",
    "test:one": "node test/m6.mjs"
  },
  "files": [
